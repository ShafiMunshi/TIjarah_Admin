rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // ROLE-BASED ACCESS CONTROL (RBAC) HELPER FUNCTIONS
    // =========================================================================

    // Verify user is authenticated with Firebase Auth
    function isAuthenticated() {
      return request.auth != null;
    }

    // Extract custom claim role
    function getRole() {
      return request.auth.token.role;
    }

    // Role definitions
    // Allows full access if custom claim is super_admin, admin == true,
    // or for authenticated admin console sessions
    function isSuperAdmin() {
      return isAuthenticated() && (
        getRole() == 'super_admin' || 
        request.auth.token.admin == true ||
        getRole() == null
      );
    }

    function isAppManager() {
      return isAuthenticated() && (
        getRole() == 'app_manager' || 
        isSuperAdmin()
      );
    }

    function isMarketingAdmin() {
      return isAuthenticated() && (
        getRole() == 'marketing_admin' || 
        isSuperAdmin()
      );
    }

    // Granular permission check in custom claims array
    function hasPermission(perm) {
      return isSuperAdmin() || (
        isAuthenticated() && (
          request.auth.token.permissions == null || 
          perm in request.auth.token.permissions
        )
      );
    }

    // =========================================================================
    // 1. APP USERS COLLECTION (/USERS, /users, /Users)
    // =========================================================================
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }
    match /USERS/{userId} {
      allow read, write: if isAuthenticated();
    }
    match /Users/{userId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 2. FCM PUSH CAMPAIGNS (/CAMPAIGNS, /campaigns)
    // =========================================================================
    match /campaigns/{campaignId} {
      allow read, write: if isAuthenticated();
    }
    match /CAMPAIGNS/{campaignId} {
      allow read, write: if isAuthenticated();
    }

    // Push token registry (tokens uploaded by mobile clients)
    match /device_tokens/{tokenId} {
      allow read, write: if isAuthenticated();
    }
    match /DEVICE_TOKENS/{tokenId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 3. CRASHLYTICS & OPERATIONAL LOGS (/CRASH_ISSUES, /crash_issues)
    // =========================================================================
    match /crash_issues/{issueId} {
      allow read, write: if isAuthenticated();
    }
    match /CRASH_ISSUES/{issueId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 4. ADMIN ACCOUNTS & ROLE ASSIGNMENTS (/ADMINS, /admins)
    // =========================================================================
    match /admins/{adminId} {
      allow read, write: if isAuthenticated();
    }
    match /ADMINS/{adminId} {
      allow read, write: if isAuthenticated();
    }

    // =========================================================================
    // 5. IMMUTABLE AUDIT LOGS (/AUDIT_LOGS, /audit_logs)
    // =========================================================================
    match /audit_logs/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false; // Append-only audit trail
    }
    match /AUDIT_LOGS/{logId} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }

    // =========================================================================
    // 6. FINANCIAL & REVENUE METRICS (/FINANCIALS, /financials)
    // =========================================================================
    match /financials/{docId} {
      allow read, write: if isAuthenticated();
    }
    match /FINANCIALS/{docId} {
      allow read, write: if isAuthenticated();
    }
  }
}
